# RansomTrace Platform - Environment Configuration Example
# Copy this file to .env and customize with your deployment parameters.
# NEVER commit the actual .env file or real production credentials to version control.

# Core Application Settings
PROJECT_NAME="RansomTrace"
VERSION="1.0.0"
ENVIRONMENT="development"    # Options: development, staging, production
DEBUG="false"                # CRITICAL: Always set to false in production

# Database Configuration
# Default: Local SQLite (sqlite:///./ransomtrace.db)
# Production PostgreSQL example:
DATABASE_URL="postgresql://db_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/ransomtrace_db"

# CORS Allowed Origins
# Comma-separated list or JSON array of trusted frontend domains
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Blockchain Provider API
# Mempool API base endpoint (default public endpoint)
MEMPOOL_API_BASE="https://mempool.space/api"
HTTP_TIMEOUT_SECONDS=15

# Rate Limiting & Protection
# Maximum API requests per minute per IP address
RATE_LIMIT_PER_MINUTE=180

# Forensic Evidence Storage Directory
EVIDENCE_VAULT_DIR="./data/evidence_vault"

# Hybrid Risk Scoring Weights (Must sum to 1.0)
RISK_RULE_WEIGHT=0.50
RISK_ML_WEIGHT=0.50

# Security / Authentication Architecture Readiness
# Secret key used for session/JWT token signing (generate via `openssl rand -hex 32`)
SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHARACTER_RANDOM_HEX_SECRET_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
