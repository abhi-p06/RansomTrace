# RansomTrace Platform - Backend Environment Configuration Example
# Copy this file to backend/.env and customize with your deployment parameters.
# NEVER commit the actual .env file or real production credentials to version control.

# Core Application Settings
PROJECT_NAME="RansomTrace"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG="false"

# Database Configuration
DATABASE_URL="postgresql://db_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/ransomtrace_db"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Blockchain Provider API
MEMPOOL_API_BASE="https://mempool.space/api"
HTTP_TIMEOUT_SECONDS=15

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=180

# Forensic Evidence Storage Directory
EVIDENCE_VAULT_DIR="./data/evidence_vault"

# Hybrid Risk Scoring Weights
RISK_RULE_WEIGHT=0.50
RISK_ML_WEIGHT=0.50

# Security / Authentication Architecture Readiness
SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHARACTER_RANDOM_HEX_SECRET_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
